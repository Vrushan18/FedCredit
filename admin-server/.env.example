# ============================================================
# FedCredit Head Office — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Server Ports ---
API_PORT=8000
FLOWER_PORT=8080

# --- JWT Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ADMIN_JWT_SECRET=change_me_admin_secret
CUSTOMER_JWT_SECRET=change_me_customer_secret

# --- Flower FL ---
NUM_ROUNDS=5
MIN_FIT_CLIENTS=2
MIN_EVAL_CLIENTS=2
MIN_AVAIL_CLIENTS=2

# --- Fraud Registry ---
# Bank API keys are generated by the admin seed script and stored hashed.
# Fill these in after running: python -m backend.admin.seed_banks

BANK_A_API_KEY=change_me_bank_a_key
BANK_B_API_KEY=change_me_bank_b_key

# --- Tailscale IP of this machine (Head Office) ---
SERVER_IP=127.0.0.1

# --- CORS allowed origin(s) for the Customer Portal ---
PORTAL_ORIGIN=http://localhost:5173
